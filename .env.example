# =============================================================================
# QUOTATION SYSTEM — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# In Excel VBA, set these as Windows System Environment Variables.
# =============================================================================

# Azure SQL connection
COT_DB_SERVER=your-server.database.windows.net
COT_DB_NAME=your_database
COT_DB_USER=your_db_user
COT_DB_PASSWORD=your_db_password

# CRM API
COT_CRM_BASE=https://your-crm.example.com/api/1/
COT_CRM_TOKEN=your_crm_api_token_here
